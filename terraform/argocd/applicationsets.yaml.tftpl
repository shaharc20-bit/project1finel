# Argo CD Application that reads gitops/applicationsets/ and creates the ApplicationSets
# (flask-aws-monitor dev/qa/prd, stress-app dev/qa/prd, bonus apps nginx/redis).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: applicationsets
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${repo_url}
    targetRevision: main
    path: gitops/applicationsets
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
