pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    parameters {
        booleanParam(name: 'MOCK_CHECKS', defaultValue: false, description: 'Run mock lint/security steps instead of the real tools')
        booleanParam(name: 'PUSH_GITOPS', defaultValue: true, description: 'Render the Helm chart and push it to the GitOps repo')
    }

    environment {
        CODE_DIR    = 'code'
        APP_DIR     = 'code/app'
        CHART_DIR   = 'code/helm/flask-aws-monitor'
        VALUES_DIR  = 'code/helm/values'
        IMAGE_NAME  = "${env.DOCKERHUB_USER}/flask-aws-monitor"
        IMAGE_TAG   = "${BUILD_NUMBER}"
        TRIVY_CACHE = 'trivy-cache:/root/.cache/'
    }

    stages {
        stage('Clone Repository') {
            steps {
                script {
                    def scmVars = checkout scm
                    sh 'git log -1 --oneline'
                    env.RUN_CI = 'true'
                    def byPolling = !currentBuild.getBuildCauses('hudson.triggers.SCMTrigger$SCMTriggerCause').isEmpty()
                    if (byPolling && scmVars.GIT_PREVIOUS_COMMIT) {
                        def changed = sh(returnStdout: true, script: "git diff --name-only ${scmVars.GIT_PREVIOUS_COMMIT} HEAD -- ${env.CODE_DIR}/ 2>/dev/null || echo unknown").trim()
                        if (!changed) {
                            env.RUN_CI = 'false'
                            currentBuild.description = "No changes in ${env.CODE_DIR}/"
                            echo "No changes in ${env.CODE_DIR}/ - skipping CI"
                        }
                    }
                }
            }
        }

        stage('Parallel Checks') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            parallel {
                stage('Lint: Python (flake8)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: flake8 code/app'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q flake8 && flake8 ."'
                            }
                        }
                    }
                }
                stage('Lint: Dockerfile (hadolint)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: hadolint code/app/Dockerfile'
                            } else {
                                sh 'docker run --rm -i hadolint/hadolint < $APP_DIR/Dockerfile'
                            }
                        }
                    }
                }
                stage('Lint: Shell (shellcheck)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: shellcheck'
                            } else {
                                sh '''
                                    files=$(find . -name "*.sh" -not -path "./.git/*")
                                    if [ -n "$files" ]; then
                                        docker run --rm -v "$WORKSPACE":/src -w /src koalaman/shellcheck:stable $files
                                    else
                                        echo "No shell scripts to check"
                                    fi
                                '''
                            }
                        }
                    }
                }
                stage('Lint: Helm') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: helm lint'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src alpine/helm:latest lint $CHART_DIR'
                            }
                        }
                    }
                }
                stage('Security: Bandit') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: bandit -r code/app'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q bandit && bandit -r . -x ./tests -ll"'
                            }
                        }
                    }
                }
                stage('Security: Trivy (fs)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: trivy fs .'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -v $TRIVY_CACHE aquasec/trivy:latest fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 0 /src'
                            }
                        }
                    }
                }
                stage('Unit Tests') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: pytest code/app/tests'
                            } else {
                                sh 'docker run --rm -e PYTHONDONTWRITEBYTECODE=1 -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q -r requirements-dev.txt && python -m pytest -q -p no:cacheprovider tests"'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest $APP_DIR'
            }
        }

        stage('Scan Image (Trivy)') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                script {
                    if (params.MOCK_CHECKS) {
                        echo "MOCK: trivy image ${IMAGE_NAME}:${IMAGE_TAG}"
                    } else {
                        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v $TRIVY_CACHE aquasec/trivy:latest image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 0 $IMAGE_NAME:$IMAGE_TAG'
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_TOKEN')]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                        docker push $IMAGE_NAME:$IMAGE_TAG
                        docker push $IMAGE_NAME:latest
                    '''
                }
            }
        }

        stage('Helm Template') {
            when {
                allOf {
                    environment name: 'RUN_CI', value: 'true'
                    expression { params.PUSH_GITOPS }
                }
            }
            steps {
                sh '''
                    rm -rf rendered && mkdir -p rendered
                    for env in dev qa prd; do
                        docker run --rm -v "$WORKSPACE":/src -w /src alpine/helm:latest template flask-aws-monitor $CHART_DIR \
                            -f $VALUES_DIR/$env.yaml \
                            --set image.repository=$IMAGE_NAME \
                            --set image.tag=$IMAGE_TAG \
                            --namespace flask-$env > rendered/$env.yaml
                    done
                    ls -la rendered
                '''
            }
        }

        stage('Push to GitOps Repo') {
            when {
                allOf {
                    environment name: 'RUN_CI', value: 'true'
                    expression { params.PUSH_GITOPS }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        rm -rf gitops-work
                        git clone --depth 1 --branch "$GITOPS_BRANCH" "https://${GIT_USER}:${GIT_TOKEN}@${GITOPS_REPO#https://}" gitops-work
                        for env in dev qa prd; do
                            mkdir -p "gitops-work/$GITOPS_PATH/envs/$env"
                            cp "rendered/$env.yaml" "gitops-work/$GITOPS_PATH/envs/$env/flask-aws-monitor.yaml"
                        done
                        cd gitops-work
                        git config user.name "jenkins"
                        git config user.email "jenkins@builder.local"
                        git add "$GITOPS_PATH/envs"
                        if git commit -m "gitops: flask-aws-monitor $IMAGE_TAG"; then
                            for attempt in 1 2 3; do
                                git push origin "HEAD:$GITOPS_BRANCH" && break
                                echo "push rejected (attempt $attempt), rebasing"
                                git pull --rebase origin "$GITOPS_BRANCH"
                            done
                        else
                            echo "No changes"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            sh 'docker image rm $IMAGE_NAME:$IMAGE_TAG || true'
            deleteDir()
        }
        success {
            script {
                if (env.RUN_CI == 'true') {
                    echo "Pushed ${IMAGE_NAME}:${IMAGE_TAG} and updated ${env.GITOPS_PATH}/envs"
                }
            }
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}
